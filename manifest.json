{
  "manifest_version": 3,
  "name": "Telemetry Blocker",
  "version": "0.1.0",
  "description": "Blocks analytics, crash reporters and ad pixels. Nothing else.",
  "action": {
    "default_title": "Telemetry Blocker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["declarativeNetRequest", "storage", "alarms"],
  "host_permissions": [
    "<all_urls>",
    "https://raw.githubusercontent.com/*",
    "https://easylist.to/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "telemetry",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}